          "expr": "sum(rate(http_request_errors_total{job=\"wms-service\"}[1m])) by (error_type)",
          "legendFormat": "{{ error_type }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        },
        "overrides": []
      }
    },
    {
      "title": "WMS Service — Total Requests",
      "type": "stat",
